function generarFibonacci(cantidad) {
    if (cantidad < 0 || !Number.isInteger(cantidad)) return "Error: Ingrese un número entero positivo.";
    if (cantidad <= 0) return [];
    if (cantidad === 1) return;
    
    const serie =;
for (let i = 2; i < cantidad; i++) {
        serie.push(serie[i - 1] + serie[i - 2]);
    }
    
    return serie;
}

const mostrarRetoInteractiva = () => {
    const entrada = prompt("¿Cuántos números de la serie Fibonacci deseas generar?");
    const limite = Number(entrada);
    const resultado = generarFibonacci(limite);
    
    if (typeof resultado === "string") {
        console.error(resultado);
        alert(resultado); // Muestra el error en una ventana flotante
    } 
    else {
        const mensaje = `Los primeros ${limite} números de Fibonacci son:\n${resultado.join(", ")}`;
        console.log(mensaje);
        alert(mensaje); // Muestra el resultado en una ventana flotante
    }
};

mostrarReto();
